# 复制本文件为 .env（生产构建 / Docker Compose）或 .env.development.local（npm run dev）

# ---- 生图服务 (Image Generation API) ----
# OpenAI 兼容接口，可带或不带 /v1
VITE_IMAGE_API_BASE_URL=
VITE_IMAGE_API_KEY=
# 弹窗中关于 API Key 的提示引导文案（不填则默认为：令牌只保存在本机浏览器，不会上传到工作台服务器）
VITE_IMAGE_API_KEY_HINT=

# ---- 提示词优化服务 (LLM Prompt Optimizer API) ----
# 专门用于生图提示词精准优化的语言模型接口（与生图服务独立配置）
VITE_OPTIMIZER_API_BASE_URL=
VITE_OPTIMIZER_API_KEY=
VITE_OPTIMIZER_API_KEY_HINT=
# 使用服务实际支持的模型名称；留空时可在设置中手动填写或获取
VITE_OPTIMIZER_MODEL=
VITE_OPTIMIZER_ENDPOINT=/v1/chat/completions
# 留空使用内置优化模板；自定义模板使用 {prompt} 插入用户提示词
VITE_OPTIMIZER_PROMPT_TEMPLATE=

# ---- Docker 运行时 ----
# 127.0.0.1 = 仅本机（配合 Tunnel / 反代）；0.0.0.0 = 对公网开放
BIND_HOST=127.0.0.1
HOST_PORT=3000
# iframe 父页面来源。* 允许任意站点嵌入；也可写成 https://your-gateway.example.com
NGINX_FRAME_ANCESTORS=*
