# 复制本文件为 .env（Docker / 生产运行）或 .env.development.local（npm run dev）

# ---- 生图服务 (Image Generation API) ----
# OpenAI 兼容接口，可带或不带 /v1
VITE_IMAGE_API_BASE_URL=
VITE_IMAGE_API_KEY=
# 弹窗中关于 API Key 的提示引导文案（不填则默认为：令牌只保存在本机浏览器，不会上传到工作台服务器）
VITE_IMAGE_API_KEY_HINT=

# ---- 提示词优化服务 (LLM Prompt Optimizer API) ----
# 专门用于生图提示词精准优化的语言模型接口（与生图服务独立配置）
VITE_OPTIMIZER_API_BASE_URL=
VITE_OPTIMIZER_API_KEY=
VITE_OPTIMIZER_API_KEY_HINT=
VITE_OPTIMIZER_MODEL=gpt-6.1-sol
VITE_OPTIMIZER_ENDPOINT=/v1/chat/completions
# 优化提示词模板（包含 {prompt} 占位符）
VITE_OPTIMIZER_PROMPT_TEMPLATE="你是一位精通视觉生成模型（如 FLUX、Midjourney、SDXL、DALL-E 等）的提示词架构与语义优化专家。\n你的核心任务是【优化提示词】，使其描写更准确、视觉表达更具象、且更加便于 AI 模型精准理解与还原，严禁盲目扩写或堆砌无关辞藻。\n\n请遵循以下优化原则：\n1. 精准具象：将模糊、抽象或口语化的描述，转化为明确、具体的视觉特征（如明确主体特征、形态动作、材质质感、空间关系），消除歧义。\n2. 易于 AI 理解：按视觉逻辑结构化组织描述（核心主体与动作 -> 环境与构图视角 -> 光影与色彩氛围 -> 艺术风格/媒介），剔除无意义的画质废话（如“超高清”、“杰作”等），使模型能精准捕捉关键权重。\n3. 忠实核心意图：严格保持用户的原始主体、核心构想与基调，不擅自增添无关要素或篡改画面焦点。\n4. 凝练克制：注重信息密度与精准度，避免繁冗冗余的文学修饰，保持提示词精炼高效。\n5. 语言一致：保持与用户输入相同的主语言（中文输入输出中文优化，英文输入输出英文优化）。\n6. 格式要求：直接输出优化后的提示词正文，严禁输出任何问候语、前缀标签、解析说明或 Markdown 代码块。\n\n用户输入的提示词：{prompt}"

# ---- Docker 运行时 ----
# 127.0.0.1 = 仅本机（配合 Tunnel / 反代）；0.0.0.0 = 对公网开放
BIND_HOST=127.0.0.1
HOST_PORT=3000
# iframe 父页面来源。* 允许任意站点嵌入；也可写成 https://your-gateway.example.com
NGINX_FRAME_ANCESTORS=*
