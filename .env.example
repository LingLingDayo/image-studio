# 复制本文件为 .env（Docker / 生产运行）或 .env.development.local（npm run dev）

# OpenAI 兼容接口，可带或不带 /v1
VITE_IMAGE_API_BASE_URL=
VITE_IMAGE_API_KEY=
# 弹窗中关于 API Key 的提示引导文案（不填则默认为：令牌只保存在本机浏览器，不会上传到工作台服务器）
VITE_IMAGE_API_KEY_HINT=

# ---- Docker 运行时 ----
# 127.0.0.1 = 仅本机（配合 Tunnel / 反代）；0.0.0.0 = 对公网开放
BIND_HOST=127.0.0.1
HOST_PORT=3000
# iframe 父页面来源。* 允许任意站点嵌入；也可写成 https://your-gateway.example.com
NGINX_FRAME_ANCESTORS=*
