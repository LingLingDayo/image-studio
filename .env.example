# 复制本文件为 .env（Docker / 生产运行）或 .env.development.local（npm run dev）

# ---- 生图服务 (Image Generation API) ----
# OpenAI 兼容接口，可带或不带 /v1
VITE_IMAGE_API_BASE_URL=
VITE_IMAGE_API_KEY=
# 弹窗中关于 API Key 的提示引导文案（不填则默认为：令牌只保存在本机浏览器，不会上传到工作台服务器）
VITE_IMAGE_API_KEY_HINT=

# ---- 提示词优化服务 (LLM Prompt Optimizer API) ----
# 专门用于扩写和优化生图提示词的语言模型接口（与生图服务独立配置）
VITE_OPTIMIZER_API_BASE_URL=
VITE_OPTIMIZER_API_KEY=
VITE_OPTIMIZER_API_KEY_HINT=
VITE_OPTIMIZER_MODEL=gpt-4o-mini
VITE_OPTIMIZER_ENDPOINT=/v1/chat/completions
# 优化提示词模板（包含 {prompt} 占位符）
VITE_OPTIMIZER_PROMPT_TEMPLATE="You are a master AI prompt engineer specializing in text-to-image prompts (e.g. Midjourney, DALL-E 3, FLUX, Stable Diffusion). Your task is to expand and enhance the user's brief concept into a rich, evocative, highly-detailed English prompt. Focus on: main subject details, artistic style, composition, lighting, color palette, camera lens/angle, textures, and atmosphere. Keep the original intent and core elements intact. Output ONLY the optimized prompt directly without any introductory, conversational, or markdown explanatory text.\n\nUser input: {prompt}"

# ---- Docker 运行时 ----
# 127.0.0.1 = 仅本机（配合 Tunnel / 反代）；0.0.0.0 = 对公网开放
BIND_HOST=127.0.0.1
HOST_PORT=3000
# iframe 父页面来源。* 允许任意站点嵌入；也可写成 https://your-gateway.example.com
NGINX_FRAME_ANCESTORS=*
